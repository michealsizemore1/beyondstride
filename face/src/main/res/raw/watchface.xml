<?xml version="1.0" encoding="utf-8"?>
<!-- TEST (no complication slots) — BeyondStride watch face (Watch Face Format v1). Every text is 26 px except the time (96 px). Data comes from the BeyondStride watch app's complications. -->
<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>
  <Scene backgroundColor="#FF000000">
    <PartText x="110" y="26" width="230" height="34"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" color="#FFC6F432" weight="BOLD"><Template>%s %s    BAT %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[BATTERY_PERCENT]"/></Template></Font></Text></PartText>
    <DigitalClock x="35" y="166" width="380" height="100">
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="380" height="100">
        <Font family="SYNC_TO_DEVICE" size="96" color="#FFFFFFFF" weight="BOLD"></Font>
      </TimeText>
    </DigitalClock>
    <PartText x="60" y="262" width="330" height="34"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" color="#FFFFFFFF" weight="BOLD"><Template>%s bpm    %s steps<Parameter expression="[HEART_RATE]"/><Parameter expression="[STEP_COUNT]"/></Template></Font></Text></PartText>
  </Scene>
</WatchFace>
